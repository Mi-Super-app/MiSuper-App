# Copia este archivo como .env y llena tus datos. El .env NO se sube a GitHub.

# Conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/misuper

PORT=3000

# --- Actualización automática de precios (node-cron) ---
# Horario en formato cron. "0 6 * * *" = todos los días a las 6:00 a.m. (hora de Nicaragua)
CRON_PRECIOS=0 6 * * *
# Pon false para apagar la actualización automática
ACTUALIZACION_AUTOMATICA=true
# Si un precio cambia más de este porcentaje en un día, se marca para revisión (0.5 = 50 %)
CAMBIO_MAXIMO_PRECIO=0.5
# Supermercados que NO se consultan ni se muestran en la app (por ejemplo, si alguno
# te pide que dejes de mostrar sus precios). Separados por coma. Vacío = ninguno.
#   SUPERS_PAUSADOS=walmart
#   SUPERS_PAUSADOS=walmart,la-union
SUPERS_PAUSADOS=

# Clave para las rutas /api/actualizaciones (déjala vacía mientras pruebas en tu compu)
ADMIN_CLAVE=

# --- Cuentas (login opcional) ---
# Clave secreta para firmar las sesiones. Inventá una larga y al azar (40+ caracteres).
# Para generar una:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA la subas a GitHub. Si la cambiás, todos tienen que volver a entrar.
JWT_SECRET=

# --- "Olvidé mi contraseña" (correo para recuperarla) ---
# Dirección pública de la app, para el link del correo. En tu compu podés dejarla vacía.
# En Render es OBLIGATORIA, ej: https://misuper.onrender.com  (sin / al final)
APP_URL=
# Correo desde el que se mandan los mensajes
CORREO_REMITENTE=
# Opción 1 (recomendada en Render gratis): Brevo, https://www.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
# Opción 2: SMTP (ej. Gmail con "contraseña de aplicación"). Render gratis bloquea SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Si no configurás ninguna, el link se muestra en la consola del servidor (para pruebas).
