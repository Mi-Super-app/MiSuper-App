# Copia este archivo como .env y llena tus datos. El .env NO se sube a GitHub.

# Conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/misuper

PORT=3000

# --- Actualización automática de precios (node-cron) ---
# Horario en formato cron. "0 6 * * *" = todos los días a las 6:00 a.m. (hora de Nicaragua)
CRON_PRECIOS=0 6 * * *
# Pon false para apagar la actualización automática
ACTUALIZACION_AUTOMATICA=true
# Si un precio cambia más de este porcentaje en un día, se marca para revisión (0.5 = 50 %)
CAMBIO_MAXIMO_PRECIO=0.5

# Clave para las rutas /api/actualizaciones (déjala vacía mientras pruebas en tu compu)
ADMIN_CLAVE=
